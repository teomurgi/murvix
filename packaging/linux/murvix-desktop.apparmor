# Optional Ubuntu 24.04 integration for WebKitGTK's user-namespace sandbox.
# Install as /etc/apparmor.d/murvix-desktop, then reload with apparmor_parser -r.
# Adapt the attachment path if XDG_DATA_HOME has been customized.
abi <abi/4.0>,
include <tunables/global>

profile murvix-desktop @{HOME}/.local/share/murvix-desktop{,-beta}/versions/*/murvix-app flags=(unconfined) {
    userns,
}

profile murvix-desktop-package /usr/lib/murvix-desktop{,-beta}/murvix-app flags=(unconfined) {
    userns,
}

profile murvix-desktop-appimage @{HOME}/.local/share/murvix-appimage/*/usr/bin/murvix-app flags=(unconfined) {
    userns,
}
