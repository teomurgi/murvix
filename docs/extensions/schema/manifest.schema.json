{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murvix.app/schema/manifest.schema.json",
  "title": "Murvix Extension package.json",
  "description": "Authoring schema for Murvix extension package.json files. The runtime loader is the source of truth (crates/murvix-app-core/src/extensions/manifest.rs). This schema catches unknown manifest keys and recommends nonempty IDs, but cannot validate resource files or cross-references. The loader also accepts null for optional fields.",
  "type": "object",
  "required": ["name", "version", "murvix"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema for editor autocomplete. Ignored by the app loader."
    },
    "name": {
      "type": "string",
      "description": "Extension identifier: ASCII letters, digits, underscore, dash, dot; no leading dot. Installed packages must match their directory name. Pages additionally require lowercase letters, digits, dash and dot only. The name foundation is reserved.",
      "pattern": "^(?!\\.)[A-Za-z0-9_.-]+$",
      "not": { "const": "foundation" },
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "description": "Nonempty version string required by the loader. Use semver for marketplace updates.",
      "minLength": 1
    },
    "scripts": {
      "type": "object",
      "description": "Optional npm scripts. When using a build, produce dist/ with package.json and all referenced extension assets; no build script is required by the app loader.",
      "properties": {
        "build": { "type": "string", "minLength": 1 }
      }
    },
    "murvix": {
      "type": "object",
      "description": "Murvix manifest fields. Entry/asset paths resolve against dist/ when that directory exists, otherwise the package folder.",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Optional pointer to this schema. Ignored by the app loader."
        },
        "description": {
          "type": "string"
        },
        "background": {
          "type": "string",
          "description": "Relative path to a background JS file inside the build output. Use for app events, extension-local events, or background shell commands."
        },
        "events": {
          "type": "array",
          "description": "App events this extension may subscribe to (pane.created, pane.closed, pane.focused, tab.created, tab.updated, tab.closed, tab.focused, panel.opened, panel.closed, popover.opened, popover.closed, modal.opened, modal.closed, project.switched, projects.changed, worktree.switched, worktree.headChanged, notification.posted, agent.status, file.changed). worktree.offline is not emitted. Same-extension extension.* events are local and need no declaration. Intercepting closes (murvix.lifecycle) needs no declaration.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permission" }
        },
        "tabTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/tabType" }
        },
        "homeViews": {
          "type": "array",
          "description": "Parsed legacy compatibility field. Entries are validated, but no home-view UI is implemented.",
          "items": { "$ref": "#/$defs/homeView" }
        },
        "fileOpeners": {
          "type": "array",
          "description": "File openers this extension contributes. Murvix passes filePath plus optional line/column data to the referenced tabType when a terminal link opens a project file.",
          "items": { "$ref": "#/$defs/fileOpener" }
        },
        "localizations": {
          "type": "array",
          "description": "App-language providers backed by resource-only .bundle folders. Users choose among enabled providers in Settings.",
          "items": { "$ref": "#/$defs/localization" },
          "uniqueItems": true
        },
        "panels": {
          "type": "array",
          "items": { "$ref": "#/$defs/panel" }
        },
        "popovers": {
          "type": "array",
          "items": { "$ref": "#/$defs/popover" }
        },
        "sidebar": { "$ref": "#/$defs/sidebar" },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "topbarItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/topbarItem" }
        },
        "statusBarItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/statusBarItem" }
        },
        "settings": {
          "type": "array",
          "description": "Preferences shown in Settings → Extensions. Their values are not exposed to extension code; use storage for values needed at runtime.",
          "items": { "$ref": "#/$defs/setting" }
        },
        "remoteMethods": {
          "type": "array",
          "description": "Parsed legacy compatibility field. Mobile remote-method dispatch is not implemented.",
          "items": { "$ref": "#/$defs/remoteMethod" }
        },
        "marketplace": {
          "type": "object",
          "description": "Optional listing metadata, ignored by the app loader. This repository does not define a current marketplace publishing pipeline or validate listing assets.",
          "additionalProperties": true,
          "properties": {
            "author": { "type": "string" },
            "github": { "type": "string", "description": "Author's GitHub username." },
            "homepage": { "type": "string", "format": "uri" },
            "repository": { "type": "string", "format": "uri" },
            "categories": {
              "type": "array",
              "items": { "type": "string" }
            },
            "icon": { "type": "string" },
            "screenshots": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "permission": {
      "type": "string",
      "enum": [
        "panes:read",
        "panes:write",
        "tabs:read",
        "tabs:write",
        "browser:read",
        "browser:write",
        "projects:read",
        "projects:write",
        "projects:delete",
        "worktrees:read",
        "worktrees:write",
        "agents:read",
        "git:read",
        "git:write",
        "gh:read",
        "files:read",
        "files:write",
        "storage:read",
        "storage:write",
        "notifications:write",
        "panels:write",
        "commands:run-script",
        "commands:exec",
        "shortcuts:register",
        "remote:serve"
      ]
    },
    "icon": {
      "description": "Either an SF Symbol name string, { symbol }, or { svg: relative-path }.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol"],
          "properties": { "symbol": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["svg"],
          "properties": { "svg": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "tabType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "entry"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "entry": { "type": "string", "minLength": 1 },
        "defaultData": {}
      }
    },
    "homeView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "entry"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/icon" },
        "entry": { "type": "string", "minLength": 1 },
        "defaultData": {}
      }
    },
    "fileOpener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tabType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "tabType": { "type": "string", "minLength": 1 },
        "patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": ["*"]
        },
        "singleton": { "type": "boolean", "default": true }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "title", "bundle"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Provider identifier unique within this extension.",
          "pattern": "^(?!\\.)[A-Za-z0-9._-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language identifier and matching .lproj directory name, such as de or pt-BR.",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "title": {
          "type": "string",
          "description": "Language name shown in Settings, preferably written in that language.",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "bundle": {
          "type": "string",
          "description": "Relative path inside the resource root (dist/ when present) to a resource-only .bundle containing <language>.lproj/Localizable.strings or Localizable.stringsdict.",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.bundle$"
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "icon": { "$ref": "#/$defs/icon" },
        "entry": { "type": "string", "minLength": 1 },
        "position": { "enum": ["right", "bottom"] },
        "mode": { "enum": ["pinned", "floating"] },
        "hiddenControls": {
          "type": "array",
          "items": { "enum": ["icon", "title", "close", "pin", "mode", "position"] },
          "uniqueItems": true
        },
        "headerButtons": {
          "type": "array",
          "items": { "$ref": "#/$defs/panelHeaderButton" }
        },
        "hideTopbar": {
          "type": "boolean",
          "default": false,
          "description": "Hide the entire panel header (icon, title, controls, and header buttons). The webview fills the whole panel."
        },
        "defaultData": {}
      }
    },
    "panelHeaderButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "icon", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/icon" },
        "tooltip": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "visible": {
          "type": "boolean",
          "default": true,
          "description": "Whether the button is shown."
        }
      }
    },
    "popover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "entry": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "defaultData": {}
      }
    },
    "sidebar": {
      "description": "A single full-height webview that replaces Murvix's built-in left sidebar when the user selects it in Settings → Appearance → Active sidebar. At most one per extension.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "icon": { "$ref": "#/$defs/icon" },
        "entry": { "type": "string", "minLength": 1 },
        "defaultData": {}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "action": { "$ref": "#/$defs/commandAction" },
        "defaultShortcut": {
          "type": "string",
          "minLength": 1,
          "description": "Default keyboard shortcut for this command, e.g. \"cmd+shift+e\". Must include at least one of cmd, ctrl, or opt; bare keys are ignored. Auto-assigned on load when free; registered unassigned when the combo is already taken. Editable in Settings → Keyboard."
        }
      }
    },
    "commandAction": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["event", "openTab", "togglePanel", "openPanel", "openPopover", "openModal", "runScript"],
          "description": "openPanel shows a panel without toggling it."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "openTab" } } },
          "then": {
            "required": ["tabType"],
            "properties": {
              "kind": {},
              "tabType": { "type": "string", "minLength": 1 },
              "data": {}
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "kind": { "const": "togglePanel" } } },
          "then": {
            "required": ["panel"],
            "properties": {
              "kind": {},
              "panel": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "kind": { "const": "openPanel" } } },
          "then": {
            "required": ["panel"],
            "properties": {
              "kind": {},
              "panel": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "kind": { "const": "openPopover" } } },
          "then": {
            "required": ["popover"],
            "properties": {
              "kind": {},
              "popover": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "kind": { "const": "openModal" } } },
          "then": {
            "required": ["entry"],
            "properties": {
              "kind": {},
              "entry": { "type": "string", "minLength": 1, "description": "HTML asset rendered in the modal; resolves inside the extension directory." },
              "width": { "type": "number" },
              "height": { "type": "number" },
              "dismissOnOutsideClick": { "type": "boolean" },
              "data": {}
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "kind": { "const": "runScript" } } },
          "then": {
            "required": ["script"],
            "properties": {
              "kind": {},
              "script": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "kind": { "const": "event" } } },
          "then": {
            "properties": { "kind": {} },
            "additionalProperties": false
          }
        }
      ]
    },
    "topbarItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "icon", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/icon" },
        "tooltip": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" }
      }
    },
    "statusBarItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "icon", "side", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/icon" },
        "text": { "type": "string" },
        "tooltip": { "type": "string" },
        "side": { "enum": ["left", "right"] },
        "command": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "type"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "enum": ["string", "bool", "number"] },
        "defaultValue": {}
      }
    },
    "remoteMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    }
  }
}
