#!/bin/sh
set -eu
: "${MURVIX_ZIG:?Set MURVIX_ZIG to the real Zig executable}"

# The pinned native VT build otherwise specializes code to the build host CPU.
if [ "${1:-}" = build ]; then
    for argument in "$@"; do
        if [ "$argument" = -Demit-lib-vt=true ]; then
            exec "$MURVIX_ZIG" "$@" -Dcpu=baseline
        fi
    done
fi
exec "$MURVIX_ZIG" "$@"
